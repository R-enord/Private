# Copy to .env and adjust. .env is git-ignored. Never commit real secrets.
HUB_ENV=development
HUB_DATABASE_URL=postgresql+psycopg://hub:CHANGE_ME@127.0.0.1:5432/hub
# Local-only by default. Do not change without reading SECURITY.md.
HUB_BIND_HOST=127.0.0.1
HUB_PORT=8000
# Optional free tokens (raise rate limits; never required). Leave empty to run unauthenticated.
HUB_GITHUB_TOKEN=
HUB_HF_TOKEN=
# Local AI (Ollama). Run Ollama with OLLAMA_NO_CLOUD=1 to disable its paid cloud models.
HUB_OLLAMA_URL=http://127.0.0.1:11434
HUB_OLLAMA_MODEL=
HUB_OLLAMA_EMBED_MODEL=
# Resource controls
HUB_WORKER_CONCURRENCY=2
HUB_LOW_RESOURCE_MODE=false
# Phone app (see MOBILE.md). Off by default. Same Wi-Fi:
# HUB_NETWORK_MODE=lan
# HUB_BIND_HOST=0.0.0.0
# Optional https for install/offline on the phone (e.g. mkcert):
# HUB_TLS_CERT_FILE=/path/to/cert.pem
# HUB_TLS_KEY_FILE=/path/to/key.pem
# Tailscale serve: keep local mode and add your ts.net name:
# HUB_EXTRA_HOSTS=["mypc.tail1234.ts.net"]
